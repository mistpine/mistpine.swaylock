{
  "name": "mistpine.swaylock",
  "private": true,
  "version": "0.0.0",
  "description": "Tooling for mistpine.swaylock: generates the swaylock colors from the mistpine spec, checks them with swaylock 1.7.2 and 1.8.4 and renders the README images.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "check": "node scripts/generate.ts --check",
    "verify": "node scripts/verify.ts",
    "banner": "node scripts/banner.ts",
    "render": "node scripts/render.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@mistpine/port-kit": "^0.1.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
